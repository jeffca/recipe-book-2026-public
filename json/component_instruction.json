    {
        "component": "english muffin",
        "step": "1",
        "instruction": "bloom the active dry yeast by mixing water and milk in a measuring cup, heat to 35-37\u00b0C, stir and add active dry yeast. Let it sit for 10 minutes.",
        "recipe": "breakfast sandwich"
    },
    {
        "component": "english muffin",
        "step": "2",
        "instruction": "Measure out flower and put into a bowl, add salt, sugar then incorporate into flower. Add yeast mixture to flower and WARM melted butter (heat kills yeast).",
        "recipe": "breakfast sandwich"
    },
    {
        "component": "english muffin",
        "step": "3",
        "instruction": "Mix into a shaggy dough, then knead for 10 minutes or until it reaches a smooth consistency.  Shape it into a ball and place in an oil lined bowl, cover with a damp towel and let rise at room temperature for 1 hour.",
        "recipe": "breakfast sandwich"
    },
    {
        "component": "english muffin",
        "step": "4",
        "instruction": "Once dough had risen to roughly double the original size, punch it down, dust with flower and roll it out with a rolling pin, it should be about half an inch thick.",
        "recipe": "breakfast sandwich"
    },
    {
        "component": "english muffin",
        "step": "5",
        "instruction": "Cut into rounds with circular cookie cutter, place onto a baking tray that has been generously dusted with cornmeal (or less traditionally flower).  Cover with a equally sized baking tray or damp towel and let them rise for 30-60 minutes (until plump & puffy).",
        "recipe": "breakfast sandwich"
    },
    {
        "component": "english muffin",
        "step": "6",
        "instruction": "Heat up a stainless steel or cast iron pan to medium heat and add oil.  Place down as many rounds as possible into the pan, ensuring there's at least a half inch gap between each round.",
        "recipe": "breakfast sandwich"
    },
    {
        "component": "english muffin",
        "step": "7",
        "instruction": "Let cook on medium heat for 5-7 minutes on each side, if they start to burn or brown too fast, lower the heat slowly.",
        "recipe": "breakfast sandwich"
    },
    {
        "component": "english muffin",
        "step": "8",
        "instruction": "Let them cool on a wire rack, spread on butter and enjoy!",
        "recipe": "breakfast sandwich"
    },
